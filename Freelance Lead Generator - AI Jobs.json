      "name": "Fiverr Google Alert RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        352,
        448
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Replace URL with your Google Alert RSS for: site:fiverr.com AI OR LangChain OR machine learning"
