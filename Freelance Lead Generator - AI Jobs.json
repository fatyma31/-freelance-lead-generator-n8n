    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst keywords = [\n  'ai', 'machine learning', 'chatbot', 'automation', 'langchain',\n  'python', 'n8n', 'llm', 'openai', 'generative', 'nlp', 'agent',\n  'fastapi', 'rag', 'vector', 'embedding', 'developer', 'engineer'\n];\n\n// Sirf last 6 ghante ki jobs\nconst results = [];\n\nfor (const item of items) {\n  const pubDate = new Date(item.json.pubDate || 0);\n\n  const title = (item.json.title || '').toLowerCase();\n  const desc = (item.json.description || item.json.contentSnippet || '').toLowerCase();\n  const text = title + ' ' + desc;\n\n  let score = 0;\n  for (const kw of keywords) {\n    if (text.includes(kw)) score++;\n  }\n\n  if (score > 0) {\n    results.push({\n      json: {\n        title: item.json.title,\n        link: item.json.link || '',\n        description: item.json.contentSnippet || '',\n        pubDate: item.json.pubDate,\n        relevanceScore: score\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { relevanceScore: 0, title: 'No New Jobs Today' }}];\n}\n\nreturn results;\n"
      },
