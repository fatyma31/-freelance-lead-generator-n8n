    {
      "parameters": {
        "jsCode": "const allJobs = $('Merge').all();\nconst seenRows = $('Get row(s) in sheet').all();\nconst seenLinks = seenRows.map(i => i.json.jobLink).filter(Boolean);\n\nconst newJobs = allJobs.filter(item =>\n  item.json.link && !seenLinks.includes(item.json.link)\n);\n\nif (newJobs.length === 0) {\n  return [{ json: { relevanceScore: 0, title: 'No New Jobs Today' }}];\n}\nreturn newJobs;"
      },
